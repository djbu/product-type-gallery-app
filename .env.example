# Copy to .env. `shopify app dev` injects SHOPIFY_API_KEY / SHOPIFY_API_SECRET / SCOPES.
DATABASE_URL="file:./dev.sqlite"

# Filled automatically by the Shopify CLI during `shopify app dev`:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=https://your-tunnel-url
# SCOPES=read_products,read_files,write_files
