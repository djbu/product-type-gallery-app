# --- Database (Neon Postgres) ---
# Neon dashboard → your project → Connection string (use the POOLED connection
# for serverless-style hosts). Add ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Shopify ---
# Local dev: `shopify app dev` injects these automatically.
# Koyeb (production): set these as service env vars, from your Partner app.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=https://your-app.koyeb.app
# SCOPES=read_products,read_files,write_files
